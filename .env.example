# 이 파일을 .env 로 복사해 키를 채운다. .env 는 git 에 올라가지 않는다(.gitignore).

# --- 네이버 검색 API + 데이터랩 검색어트렌드 ---
# developers: developers.naver.com 에서 애플리케이션 등록 → '검색', '데이터랩(검색어트렌드)' API 추가
# apihub    : NAVER Cloud 콘솔 > API HUB 에서 발급한 키 (두 키는 서로 호환되지 않음)
NAVER_BACKEND=developers
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 네이버 검색광고 API (키워드도구: 연관검색어·월간 절대 검색수) ---
# searchad.naver.com 가입(광고 집행 불필요) → 도구 > API 사용 관리
SEARCHAD_API_KEY=
SEARCHAD_SECRET_KEY=
SEARCHAD_CUSTOMER_ID=
